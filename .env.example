# Server configuration
PORT=3000
NODE_ENV=development

# PostgreSQL configuration
DATABASE_URL=postgresql://postgres:admin@localhost:5432/chat_app_db
PGUSER=postgres
PGHOST=localhost
PGDATABASE=chat_app_db
PGPASSWORD=admin
PGPORT=5432

# Firebase Firestore configuration
# 1. Option A: Service account file path
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
# 2. Option B: Inlined JSON credentials
# FIREBASE_SERVICE_ACCOUNT_JSON=
# 3. Option C: Standard Google Application Credentials
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# 4. Option D: Local Firestore Emulator
# FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_PROJECT_ID=chat-app-backend

# Set to true to allow in-memory Firestore fallback for testing without Google Cloud account
USE_FIRESTORE_MOCK_FALLBACK=true
